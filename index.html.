<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Safe Spaces at Golden Valley School</title>
  <meta name="description" content="Safe Spaces at Golden Valley School — a student website promoting safe, supportive environments for children and teenagers.">

  <style>
    :root {
      --blue: #12519C;
      --sky: #27A0DB;
      --yellow: #F6C401;
      --text: #17324D;
      --muted: #60758A;
      --line: #E7EEF5;
      --soft: #F7FAFC;
      --white: #FFFFFF;
    }

    * {
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    html {
      scroll-padding-top: 88px;
    }

    body {
      margin: 0;
      background: var(--white);
      color: var(--text);
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1120px, calc(100% - 40px));
      margin: 0 auto;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(255, 255, 255, 0.97);
      border-bottom: 1px solid var(--line);
    }

    .header-inner {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 700;
      color: var(--blue);
      letter-spacing: -0.2px;
    }

    .brand-mark {
      width: 38px;
      height: 38px;
      border: 2px solid var(--blue);
      border-radius: 10px;
      display: grid;
      place-items: center;
      color: var(--sky);
      font-size: 19px;
      font-weight: 700;
    }

    nav ul {
      display: flex;
      align-items: center;
      gap: 28px;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    nav a {
      color: var(--blue);
      font-size: 0.95rem;
      font-weight: 600;
    }

    nav a:hover,
    nav a:focus-visible {
      color: var(--sky);
    }

    .menu-toggle {
      display: none;
      border: 1px solid var(--line);
      background: var(--white);
      color: var(--blue);
      border-radius: 8px;
      padding: 8px 10px;
      cursor: pointer;
      font-size: 18px;
    }

    .color-bar {
      height: 4px;
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
    }

    .color-bar span:nth-child(1) { background: var(--blue); }
    .color-bar span:nth-child(2) { background: var(--sky); }
    .color-bar span:nth-child(3) { background: var(--yellow); }

    main section {
      padding: 100px 0;
    }

    .hero {
      padding: 115px 0 105px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
      gap: 70px;
      align-items: center;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--sky);
      font-weight: 700;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      margin-bottom: 18px;
    }

    .eyebrow::before {
      content: "";
      width: 24px;
      height: 3px;
      background: var(--yellow);
      display: inline-block;
    }

    h1, h2, h3 {
      color: var(--blue);
      line-height: 1.15;
      margin-top: 0;
    }

    h1 {
      max-width: 760px;
      margin-bottom: 24px;
      font-size: clamp(2.7rem, 7vw, 5.2rem);
      letter-spacing: -2px;
    }

    h2 {
      font-size: clamp(2rem, 4vw, 3rem);
      margin-bottom: 18px;
      letter-spacing: -0.8px;
    }

    h3 {
      font-size: 1.15rem;
      margin-bottom: 9px;
    }

    .lead {
      max-width: 680px;
      color: var(--muted);
      font-size: 1.12rem;
      margin-bottom: 30px;
    }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 0 24px;
      border-radius: 8px;
      background: var(--blue);
      color: var(--white);
      font-weight: 700;
      border: 2px solid var(--blue);
      transition: transform 0.15s ease, background 0.15s ease;
    }

    .button:hover,
    .button:focus-visible {
      background: #0d4381;
      transform: translateY(-1px);
    }

    .stat-card {
      border: 1px solid var(--line);
      border-top: 5px solid var(--sky);
      padding: 32px;
      border-radius: 12px;
      background: var(--white);
      box-shadow: 0 12px 35px rgba(18, 81, 156, 0.08);
    }

    .stat-number {
      color: var(--blue);
      font-size: clamp(3rem, 7vw, 5rem);
      font-weight: 700;
      line-height: 1;
      letter-spacing: -2px;
    }

    .stat-label {
      margin-top: 12px;
      color: var(--muted);
      font-weight: 600;
    }

    .section-intro {
      max-width: 720px;
      margin-bottom: 46px;
    }

    .section-intro p {
      color: var(--muted);
      font-size: 1.05rem;
      margin: 0;
    }

    .signs {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .sign-card {
      padding: 30px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: var(--white);
    }

    .icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      background: #EAF5FB;
      color: var(--blue);
      margin-bottom: 22px;
      font-size: 20px;
      font-weight: 700;
    }

    .sign-card p,
    .about-copy p,
    .help-copy p {
      color: var(--muted);
      margin: 0;
    }

    .about {
      background: var(--soft);
    }

    .about-grid {
      display: grid;
      grid-template-columns: 0.75fr 1.25fr;
      gap: 80px;
      align-items: start;
    }

    .about-mark {
      width: 92px;
      height: 92px;
      border: 3px solid var(--sky);
      border-radius: 20px;
      display: grid;
      place-items: center;
      color: var(--blue);
      font-size: 38px;
      font-weight: 700;
      margin-bottom: 20px;
    }

    .dashboard-header {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 42px;
    }

    .sample-label {
      color: var(--muted);
      font-size: 0.9rem;
      font-weight: 700;
      white-space: nowrap;
    }

    .charts {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .chart-card {
      min-width: 0;
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 22px;
      background: var(--white);
    }

    .chart-wrap {
      position: relative;
      height: 280px;
    }

    .help {
      background: var(--blue);
      color: var(--white);
    }

    .help h2,
    .help h3 {
      color: var(--white);
    }

    .help .section-intro p,
    .help-copy p {
      color: #DCEAF7;
    }

    .help-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: start;
    }

    .contact-list {
      display: grid;
      gap: 14px;
      margin-top: 25px;
    }

    .contact-item {
      display: flex;
      gap: 14px;
      align-items: flex-start;
      padding: 16px 0;
      border-bottom: 1px solid rgba(255,255,255,0.16);
    }

    .contact-icon {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      background: var(--sky);
      color: var(--white);
      display: grid;
      place-items: center;
      font-weight: 700;
      flex: 0 0 auto;
    }

    .contact-item strong {
      display: block;
      margin-bottom: 2px;
    }

    .contact-item a {
      color: #DCEAF7;
      word-break: break-word;
    }

    .contact-item a:hover,
    .contact-item a:focus-visible {
      color: var(--white);
    }

    .emergency {
      border-left: 4px solid var(--yellow);
      padding: 20px 22px;
      background: rgba(255,255,255,0.08);
      border-radius: 0 10px 10px 0;
    }

    .emergency strong {
      color: var(--white);
    }

    footer {
      padding: 30px 0;
      background: #0E407A;
      color: #DCEAF7;
      font-size: 0.9rem;
    }

    footer .container {
      display: flex;
      justify-content: space-between;
      gap: 20px;
    }

    @media (max-width: 900px) {
      .hero-grid,
      .about-grid,
      .help-grid {
        grid-template-columns: 1fr;
      }

      .hero-grid {
        gap: 45px;
      }

      .about-grid {
        gap: 35px;
      }

      .signs,
      .charts {
        grid-template-columns: 1fr;
      }

      .chart-wrap {
        height: 300px;
      }

      main section {
        padding: 75px 0;
      }
    }

    @media (max-width: 700px) {
      .container {
        width: min(100% - 28px, 1120px);
      }

      .header-inner {
        min-height: 68px;
      }

      .menu-toggle {
        display: block;
      }

      nav {
        display: none;
        position: absolute;
        top: 68px;
        left: 0;
        right: 0;
        background: var(--white);
        border-bottom: 1px solid var(--line);
        padding: 10px 14px 18px;
      }

      nav.open {
        display: block;
      }

      nav ul {
        flex-direction: column;
        align-items: stretch;
        gap: 0;
      }

      nav a {
        display: block;
        padding: 13px 4px;
      }

      h1 {
        letter-spacing: -1.3px;
      }

      .hero {
        padding: 80px 0;
      }

      .stat-card {
        padding: 26px;
      }

      .dashboard-header {
        align-items: flex-start;
        flex-direction: column;
      }

      footer .container {
        flex-direction: column;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      * {
        scroll-behavior: auto !important;
        transition: none !important;
      }
    }
  </style>
</head>

<body>
  <header>
    <div class="container header-inner">
      <a class="brand" href="#home" aria-label="Safe Spaces home">
        <span class="brand-mark" aria-hidden="true">+</span>
        <span>Safe Spaces</span>
      </a>

      <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-nav">
        ☰
      </button>

      <nav id="site-nav" aria-label="Main navigation">
        <ul>
          <li><a href="#home">Home</a></li>
          <li><a href="#safe-space">Safe Space</a></li>
          <li><a href="#about">About Us</a></li>
          <li><a href="#dashboard">Dashboard</a></li>
          <li><a href="#get-help">Get Help</a></li>
        </ul>
      </nav>
    </div>
    <div class="color-bar" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
  </header>

  <main>
    <!-- 1. Hero -->
    <section class="hero" id="home">
      <div class="container hero-grid">
        <div>
          <div class="eyebrow">Golden Valley School</div>
          <h1>We want to end violence against childhood.</h1>
          <p class="lead">
            Every child and teenager deserves a place where they can feel respected,
            heard, and safe when talking about their thoughts and feelings.
          </p>
          <a class="button" href="#get-help">Get help</a>
        </div>

        <aside class="stat-card" aria-label="Website impact statistic">
          <div class="stat-number">1,000</div>
          <div class="stat-label">kids have been saved since the creation of this website.</div>
        </aside>
      </div>
    </section>

    <!-- 2. What is a Safe Space -->
    <section id="safe-space">
      <div class="container">
        <div class="section-intro">
          <div class="eyebrow">What is a Safe Space?</div>
          <h2>A place where you can be yourself.</h2>
          <p>
            A Safe Space is somewhere you feel comfortable and know you will not be
            judged when you talk about your thoughts and feelings.
          </p>
        </div>

        <div class="signs">
          <article class="sign-card">
            <div class="icon" aria-hidden="true">♥</div>
            <h3>People treat you nicely</h3>
            <p>The people around you treat you with kindness and respect.</p>
          </article>

          <article class="sign-card">
            <div class="icon" aria-hidden="true">◌</div>
            <h3>You can share your opinions</h3>
            <p>You know you can talk about your opinions without being scared.</p>
          </article>

          <article class="sign-card">
            <div class="icon" aria-hidden="true">✓</div>
            <h3>You can make good decisions</h3>
            <p>People do not pressure you to make harmful or bad decisions.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- 3. About us -->
    <section class="about" id="about">
      <div class="container about-grid">
        <div>
          <div class="about-mark" aria-hidden="true">◎</div>
          <div class="eyebrow">About us</div>
        </div>
        <div class="about-copy">
          <h2>Here to help you find a safe place.</h2>
          <p>
            We are a website that wants to help children and teenagers who are
            looking for a safe place in a violent environment.
          </p>
        </div>
      </div>
    </section>

    <!-- 4. Dashboard -->
    <section id="dashboard">
      <div class="container">
        <div class="dashboard-header">
          <div class="section-intro" style="margin-bottom: 0;">
            <div class="eyebrow">Dashboard</div>
            <h2>Our data at a glance.</h2>
          </div>
          <div class="sample-label">Sample data</div>
        </div>

        <div class="charts">
          <article class="chart-card">
            <h3>Bar chart</h3>
            <div class="chart-wrap">
              <canvas id="barChart" aria-label="Sample bar chart" role="img"></canvas>
            </div>
          </article>

          <article class="chart-card">
            <h3>Line chart</h3>
            <div class="chart-wrap">
              <canvas id="lineChart" aria-label="Sample line chart" role="img"></canvas>
            </div>
          </article>

          <article class="chart-card">
            <h3>Pie chart</h3>
            <div class="chart-wrap">
              <canvas id="pieChart" aria-label="Sample pie chart" role="img"></canvas>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- 5. Small transition / navigation anchor -->
    <section aria-hidden="true" style="padding: 0; height: 0; overflow: hidden;"></section>

    <!-- 6. Get help -->
    <section class="help" id="get-help">
      <div class="container help-grid">
        <div>
          <div class="eyebrow">Get help</div>
          <h2>You do not have to face it alone.</h2>
          <div class="help-copy">
            <p>
              If you don't feel safe, talk to the counselor Wellness. Reaching out
              to a trusted adult can be an important first step.
            </p>
          </div>
        </div>

        <div>
          <div class="contact-list">
            <div class="contact-item">
              <div class="contact-icon" aria-hidden="true">@</div>
              <div>
                <strong>Email</strong>
                <a href="mailto:studentwellnessdepartment@goldenvalley.ed.cr">
                  studentwellnessdepartment@goldenvalley.ed.cr
                </a>
              </div>
            </div>

            <div class="contact-item">
              <div class="contact-icon" aria-hidden="true">☎</div>
              <div>
                <strong>Phone</strong>
                <a href="tel:88674536">88674536</a>
              </div>
            </div>
          </div>

          <div class="emergency">
            <strong>Emergency: 911</strong>
            <div>If you are in immediate danger, contact emergency services.</div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <span>Golden Valley School</span>
      <span>2026</span>
    </div>
  </footer>

  <!-- Chart.js is loaded from its official CDN; all custom JavaScript remains in this file. -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script>
    const chartFont = {
      family: "Arial, Helvetica, sans-serif"
    };

    const commonOptions = {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          labels: {
            font: chartFont
          }
        }
      },
      scales: {
        x: {
          ticks: { font: chartFont },
          grid: { display: false }
        },
        y: {
          beginAtZero: true,
          ticks: { font: chartFont },
          grid: { color: "#E7EEF5" }
        }
      }
    };

    new Chart(document.getElementById("barChart"), {
      type: "bar",
      data: {
        labels: ["Jan", "Feb", "Mar", "Apr", "May"],
        datasets: [{
          label: "Students reached",
          data: [120, 180, 145, 230, 190],
          backgroundColor: "#27A0DB",
          borderColor: "#12519C",
          borderWidth: 1
        }]
      },
      options: commonOptions
    });

    new Chart(document.getElementById("lineChart"), {
      type: "line",
      data: {
        labels: ["Jan", "Feb", "Mar", "Apr", "May", "Jun"],
        datasets: [{
          label: "Support requests",
          data: [40, 52, 47, 68, 61, 82],
          borderColor: "#12519C",
          backgroundColor: "rgba(39, 160, 219, 0.12)",
          fill: true,
          tension: 0.3,
          pointBackgroundColor: "#27A0DB",
          pointBorderColor: "#12519C"
        }]
      },
      options: commonOptions
    });

    new Chart(document.getElementById("pieChart"), {
      type: "pie",
      data: {
        labels: ["Counseling", "Trusted adult", "Peer support"],
        datasets: [{
          data: [45, 35, 20],
          backgroundColor: ["#12519C", "#27A0DB", "#F6C401"],
          borderColor: "#FFFFFF",
          borderWidth: 3
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: "bottom",
            labels: { font: chartFont }
          }
        }
      }
    });

    const menuButton = document.querySelector(".menu-toggle");
    const nav = document.querySelector("#site-nav");

    menuButton.addEventListener("click", () => {
      const isOpen = nav.classList.toggle("open");
      menuButton.setAttribute("aria-expanded", isOpen);
      menuButton.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");
    });

    document.querySelectorAll("#site-nav a").forEach(link => {
      link.addEventListener("click", () => {
        nav.classList.remove("open");
        menuButton.setAttribute("aria-expanded", "false");
        menuButton.setAttribute("aria-label", "Open menu");
      });
    });
  </script>
</body>
</html>
